    gap:20px;
}

.skill{
    text-align:center;
}

.skill-icon{
    font-size:40px;
    margin-bottom:15px;
}

.skill h3{
    margin-bottom:8px;
}

.skill p{
    font-size:14px;
}

/* ===============================
   SOCIAL
================================ */

.social{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
}

.social a{
    text-decoration:none;
    color:white;
    padding:18px;
